{
  "name": "solstice-sanctuary-api",
  "version": "1.0.0",
  "description": "Backend API for Solstice Sanctuary Airbnb-clone",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed-photos": "node scripts/seed-photos.js",
    "seed-photos:dry": "node scripts/seed-photos.js --dry-run",
    "seed-photos:clear": "node scripts/seed-photos.js --clear 1"
